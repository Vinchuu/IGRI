# Discord Bot Configuration
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_discord_server_id_here

# Administration
ADMIN_ROLE_ID=your_admin_role_id_here

# Economy Settings (Defaults matching GDD v1.0)
STARTING_BALANCE=10000
DAILY_CLAIM_BASE=250
MAX_TICKET_STAKE=1000
MAX_OPEN_STAKE_LIMIT=3000
MIN_COMBO_SIZE=2
MAX_COMBO_SIZE=5
SEASON_COIN_SINK_PERCENT=5
ROLLOVER_CAP=100000

# Database
DATABASE_PATH=./data/igri_arena.db

# Command Prefix (Supports ! and . by default)
PREFIX=!

# Audit & Operational Logs Channel
LOG_CHANNEL_ID=your_log_channel_id_here
